# Copy to .env (cp .env.example .env). Every variable of every service lives here.
# Secrets are marked SECRET: no defaults in code, each app fails fast at boot if missing.
# These values are DEV/DEMO values; change them for any real deployment.

# ---------- Postgres ----------
POSTGRES_USER=clinic
# SECRET
POSTGRES_PASSWORD=clinic_dev_password
POSTGRES_DB=clinic
POSTGRES_PORT=5432
# Used by api, worker, db tools (inside compose the host is "postgres").
# SECRET
DATABASE_URL=postgres://clinic:clinic_dev_password@localhost:5432/clinic

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------- Mail stub (Mailpit) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=Clinic Network <no-reply@clinic.local>

# ---------- Booking rules (defaults = assignment values; tests override) ----------
HOLD_TTL_SECONDS=600
OFFER_TTL_SECONDS=900
MIN_LEAD_MINUTES=120
MAX_ADVANCE_DAYS=60
PREP_MINUTES=5

# ---------- Demo seed (db-init container) ----------
# SECRET: password of every seeded demo account (manager@, registrar.<city>@, doctorNN@, patientNNNNN@demo.local).
SEED_PASSWORD=Demo-Passw0rd!
SEED_ENABLED=true
SEED_RNG=12345
SEED_DOCTORS=40
SEED_PATIENTS=20000
SEED_APPOINTMENTS=150000
SEED_PAST_DAYS=150
SEED_FUTURE_DAYS=30
SEED_WAITLIST_ENTRIES=250

# ---------- Worker ----------
QUEUE_NAME=clinic-tasks
WORKER_CONCURRENCY=5
# how often due tasks are re-copied from Postgres into Redis (the safety net after Redis loss)
WORKER_RECONCILE_MS=15000
WORKER_HORIZON_SECONDS=3600
WORKER_STALLED_INTERVAL_MS=30000
WORKER_MAX_ATTEMPTS=8
WORKER_RETRY_BASE_MS=1000
# test-only knob, keep 0
WORKER_PROCESSING_DELAY_MS=0

# ---------- API ----------
NODE_ENV=production
API_PORT=54000
# true when served over https
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# the web app is served through nginx on HTTP_PORT
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# reverse proxies whose X-Forwarded-For may be believed (docker network); empty = nobody
TRUST_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8
GQL_MAX_DEPTH=10
GQL_MAX_COMPLEXITY=2000
GQL_MAX_FIELDS=400
BODY_LIMIT_KB=100
RATE_GLOBAL_PER_MIN=300
RATE_SIGNIN_PER_MIN=5
RATE_SIGNIN_IP_PER_MIN=20
RATE_SIGNUP_PER_HOUR=5
RATE_HOLD_PER_MIN=10
RATE_WS_CONNECT_PER_MIN=30
RATE_WS_SUBSCRIBE_PER_MIN=60
WS_MAX_CONN_PER_IP=10
WS_MAX_SUBS_PER_CONN=10
ARGON_MEMORY_KIB=19456
ARGON_TIME_COST=2
